#!/bin/sh
set -eu

if ! command -v swift-format >/dev/null 2>&1; then
    echo "swift-format is required but was not found in PATH." >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_swift_files=$(
    git diff --cached --name-only --diff-filter=ACMR -- '*.swift' 'Package.swift'
)

if [ -z "$staged_swift_files" ]; then
    exit 0
fi

echo "Formatting staged Swift files with swift-format..."

printf '%s\n' "$staged_swift_files" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    swift-format format --in-place --configuration "$repo_root/.swift-format" "$file"
    git add -- "$file"
done
